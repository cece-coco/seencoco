{
  "label": "seencoco-registers",
  "date": "2026-07-25",
  "note": "Coherence layer for the SFW funnel engine. A REGISTER is a bundle that makes an outfit, a location, a pose and an expression agree with each other. Random assembly across 772 items x 140 locations gives you a ballgown in a hardware store; a register gives you a person who made a decision that morning. Every register here is SFW by construction — this is the acquisition layer that lives on Instagram/TikTok/Reddit, NOT the paid content. Slot pools are tag filters resolved against wardrobe/catalog.json at assemble time, so new catalog items are picked up automatically.",
  "rules": {
    "exclusive": [["dress", "top"], ["dress", "bottom"]],
    "always": ["hair"],
    "never_public": ["underwear", "bra", "collar"],
    "note": "never_public is a hard gate — the funnel layer must survive platform moderation. Exposure of any kind belongs behind the wall, not in the feed."
  },
